[Unit]
Description=Assign stable lab device symlinks
After=local-fs.target
ConditionPathExists=/usr/local/sbin/device_mapper.py

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/sbin/device_mapper.py
User=root
Group=root

# Optional hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc /dev /run
